<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About Us</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* Global Styles */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: linear-gradient(135deg, #0f172a, #1e293b);
            color: #f8fafc;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow-x: hidden;
        }

        .container {
            max-width: 1200px;
            width: 100%;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        /* Left Side: Text Content */
        .about-text {
            opacity: 0;
            transform: translateX(-50px);
            animation: fadeInUp 1s forwards cubic-bezier(0.4, 0, 0.2, 1);
        }

        .tag {
            display: inline-block;
            background: rgba(59, 130, 246, 0.1);
            color: #3b82f6;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 15px;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }

        .about-text h1 {
            font-size: 2.5rem;
            margin-bottom: 20px;
            background: linear-gradient(to right, #fff, #94a3b8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .about-text p {
            color: #94a3b8;
            font-size: 1.1rem;
            line-height: 1.7;
            margin-bottom: 30px;
        }

        /* --- Circle Contact Buttons --- */
        .contact-buttons {
            display: flex;
            gap: 15px;
        }

        .circle-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 55px;
            height: 55px;
            border-radius: 50%;
            color: #fff;
            font-size: 22px;
            text-decoration: none;
            transition: transform 0.5s ease-in-out, box-shadow 0.3s;
            cursor: pointer;
            border: none;
        }

        /* বাটনগুলোর নিজস্ব ব্র্যান্ড কালার */
        .btn-call { background: #10b981; }      
        .btn-whatsapp { background: #25d366; }  
        .btn-email { background: #ef4444; }     
        .btn-facebook { background: #1877f2; }  

        /* ৩ বার ঘূর্ণন অ্যানিমেশন (1080deg) */
        .circle-btn:hover {
            transform: rotateY(1080deg);
            box-shadow: 0 0 15px rgba(59, 130, 246, 0.4);
        }

        /* Right Side: 3D Profile Card */
        .card-wrapper {
            perspective: 1000px;
            display: flex;
            justify-content: center;
            opacity: 0;
            transform: translateX(50px);
            animation: fadeInUp 1s 0.2s forwards cubic-bezier(0.4, 0, 0.2, 1);
        }

        .profile-card {
            width: 350px;
            height: 450px;
            background: linear-gradient(to bottom, #1e293b, #0f172a);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 20px;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.1s ease;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 30px;
            text-align: center;
        }

        /* প্রোফাইল ইমেজ স্টাইল (বৃত্তাকার) */
        .profile-img {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #3b82f6;
            margin-bottom: 20px;
            transform: translateZ(40px); /* 3D Depth */
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
        }

        .card-content {
            transform: translateZ(30px); /* 3D Depth */
        }

        .card-content h2 {
            font-size: 1.8rem;
            margin-bottom: 8px;
            color: #fff;
        }

        .card-content p {
            color: #3b82f6;
            font-weight: 500;
            font-size: 1rem;
        }

        /* Animations */
        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
                text-align: center;
                gap: 40px;
            }
            .contact-buttons {
                justify-content: center;
            }
            .card-wrapper {
                order: -1;
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="about-text">
            <span class="tag">আমাদের সম্পর্কে</span>
            <h1>নতুন কিছু তৈরি করাই আমাদের লক্ষ্য</h1>
            <p>আমরা একটি নিবেদিতপ্রাণ দল, যারা আধুনিক প্রযুক্তির মাধ্যমে জটিল সমস্যার সহজ এবং সুন্দর সমাধান তৈরি করতে বিশ্বাসী। কোডিং এর নিখুঁত কারিগরি এবং আকর্ষণীয় ইউজার ইন্টারফেসের সমন্বয়ে আমরা ডিজিটাল অভিজ্ঞতাকে এক অনন্য উচ্চতায় নিয়ে যাই।</p>
            
            <div class="contact-buttons">
                <a href="tel:+880123456789" class="circle-btn btn-call" title="কল করুন">
                    <i class="fa-solid fa-phone"></i>
                </a>
                <a href="https://wa.me/880123456789" target="_blank" class="circle-btn btn-whatsapp" title="হোয়াটসঅ্যাপ">
                    <i class="fa-brands fa-whatsapp"></i>
                </a>
                <a href="mailto:example@email.com" class="circle-btn btn-email" title="ইমেইল পাঠান">
                    <i class="fa-solid fa-envelope"></i>
                </a>
                <a href="https://facebook.com/yourusername" target="_blank" class="circle-btn btn-facebook" title="ফেসবুক প্রোফাইল">
                    <i class="fa-brands fa-facebook-f"></i>
                </a>
            </div>
        </div>

        <div class="card-wrapper">
            <div class="profile-card" id="threeDCard">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?q=80&w=400&auto=format&fit=crop" alt="Profile" class="profile-img">
                
                <div class="card-content">
                    <h2>আমাদের টিম</h2>
                    <p>Android & Web Development</p>
                </div>
            </div>
        </div>
    </div>

    <script>
        // --- JavaScript for 3D Card Hover Effect ---
        const card = document.getElementById('threeDCard');
        const wrapper = card.parentElement;

        wrapper.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            
            const x = e.clientX - rect.left - (rect.width / 2);
            const y = e.clientY - rect.top - (rect.height / 2);
            
            const degX = -y / 15; 
            const degY = x / 15;

            card.style.transform = `rotateX(${degX}deg) rotateY(${degY}deg)`;
        });

        wrapper.addEventListener('mouseleave', () => {
            card.style.transform = 'rotateX(0deg) rotateY(0deg)';
        });
    </script>
</body>
</html>
